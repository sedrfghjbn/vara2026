# Example .env for local development
# Rename to .env and fill values or export these vars in your environment

# Django
DEBUG=true
SECRET_KEY=change-me

# Site
SITE_BASE_URL=http://127.0.0.1:8000

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Секрет для webhook (используется только при webhook)
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_AUTO_POLL=true

# Database (example for SQLite - not required)
DATABASE_URL=sqlite:///db.sqlite3
